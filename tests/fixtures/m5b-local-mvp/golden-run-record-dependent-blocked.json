{
  "run": {
    "id": "<RUN_ID>",
    "attempt": 1,
    "status": "failure",
    "planId": "multi-item-failure",
    "mode": "local-dry-run",
    "binding": {
      "policyRef": "local-dry-run-policy",
      "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>",
      "workspace": {
        "kind": "git",
        "root": "<WORKSPACE>",
        "repoRoot": "<WORKSPACE>",
        "head": "<WORKSPACE_HEAD>",
        "changeSetHash": "<WORKSPACE_HASH>"
      }
    },
    "posture": {
      "record": "safe-for-owner-record",
      "export": "redacted"
    },
    "planSnapshot": {
      "ref": "<PLAN_SNAPSHOT_REF>",
      "path": "<PLAN_SNAPSHOT_PATH>"
    },
    "policySnapshot": {
      "ref": "<POLICY_SNAPSHOT_REF>",
      "path": "<POLICY_SNAPSHOT_PATH>"
    }
  },
  "events": [
    {
      "family": "run.started",
      "runId": "<RUN_ID>",
      "planId": "multi-item-failure",
      "mode": "local-dry-run",
      "binding": {
        "policyRef": "local-dry-run-policy",
        "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>",
        "workspace": {
          "kind": "git",
          "root": "<WORKSPACE>",
          "repoRoot": "<WORKSPACE>",
          "head": "<WORKSPACE_HEAD>",
          "changeSetHash": "<WORKSPACE_HASH>"
        }
      },
      "posture": {
        "record": "safe-for-owner-record",
        "export": "redacted"
      },
      "planSnapshot": {
        "ref": "<PLAN_SNAPSHOT_REF>",
        "path": "<PLAN_SNAPSHOT_PATH>"
      },
      "policySnapshot": {
        "ref": "<POLICY_SNAPSHOT_REF>",
        "path": "<POLICY_SNAPSHOT_PATH>"
      },
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    { "family": "story.started", "storyId": "STORY-1", "actor": "runner", "timestamp": "<TIMESTAMP>" },
    {
      "family": "evidence.modeled",
      "storyId": "STORY-1",
      "result": "failed",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.blocked",
      "storyId": "STORY-1",
      "reason": "worker-reported-failure",
      "diagnostics": {
        "exitCode": 1,
        "stdout": "Failing intentionally",
        "error": "Failing intentionally"
      },
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.blocked",
      "storyId": "STORY-2",
      "blockedBy": "STORY-1",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "run.stopped",
      "reason": "work-item-blocked",
      "checkpoint": "after:STORY-1",
      "unstarted": ["STORY-3"],
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    }
  ]
}
