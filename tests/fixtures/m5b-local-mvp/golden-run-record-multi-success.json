{
  "run": {
    "id": "<RUN_ID>",
    "attempt": 1,
    "status": "success",
    "planId": "multi-item-success",
    "mode": "local-dry-run",
    "binding": {
      "policyRef": "local-dry-run-policy",
      "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>",
      "workspace": {
        "kind": "git",
        "root": "<WORKSPACE>",
        "repoRoot": "<WORKSPACE>",
        "head": "<WORKSPACE_HEAD>",
        "changeSetHash": "<WORKSPACE_HASH>"
      }
    },
    "posture": {
      "record": "safe-for-owner-record",
      "export": "redacted"
    },
    "planSnapshot": {
      "ref": "<PLAN_SNAPSHOT_REF>",
      "path": "<PLAN_SNAPSHOT_PATH>"
    },
    "policySnapshot": {
      "ref": "<POLICY_SNAPSHOT_REF>",
      "path": "<POLICY_SNAPSHOT_PATH>"
    }
  },
  "events": [
    {
      "family": "run.started",
      "runId": "<RUN_ID>",
      "planId": "multi-item-success",
      "mode": "local-dry-run",
      "binding": {
        "policyRef": "local-dry-run-policy",
        "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>",
        "workspace": {
          "kind": "git",
          "root": "<WORKSPACE>",
          "repoRoot": "<WORKSPACE>",
          "head": "<WORKSPACE_HEAD>",
          "changeSetHash": "<WORKSPACE_HASH>"
        }
      },
      "posture": {
        "record": "safe-for-owner-record",
        "export": "redacted"
      },
      "planSnapshot": {
        "ref": "<PLAN_SNAPSHOT_REF>",
        "path": "<PLAN_SNAPSHOT_PATH>"
      },
      "policySnapshot": {
        "ref": "<POLICY_SNAPSHOT_REF>",
        "path": "<POLICY_SNAPSHOT_PATH>"
      },
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.started",
      "storyId": "STORY-1",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "evidence.modeled",
      "storyId": "STORY-1",
      "result": "passed",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.done",
      "storyId": "STORY-1",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "runner-action.skipped-on-dry-run",
      "storyId": "STORY-1",
      "action": "push|open-pr|merge",
      "reason": "dry-run",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.started",
      "storyId": "STORY-2",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "evidence.modeled",
      "storyId": "STORY-2",
      "result": "passed",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.done",
      "storyId": "STORY-2",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "runner-action.skipped-on-dry-run",
      "storyId": "STORY-2",
      "action": "push|open-pr|merge",
      "reason": "dry-run",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    { "family": "run.completed", "actor": "runner", "timestamp": "<TIMESTAMP>" }
  ]
}
