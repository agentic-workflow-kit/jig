{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "guard": {
      "dependsOn": ["guard:structure", "guard:links", "guard:boundaries", "guard:format"]
    },
    "guard:structure": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.github/workflows/check.yml",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/vitest.config.ts"
      ],
      "cache": false
    },
    "guard:links": {
      "inputs": [
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/artifacts/**"
      ],
      "outputs": []
    },
    "guard:boundaries": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/package.json", "$TURBO_ROOT$/packages/*/src/**"],
      "outputs": []
    },
    "guard:format": {
      "inputs": [
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/artifacts/**"
      ],
      "outputs": []
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.github/workflows/check.yml",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/docs/delivery/greenfield/track.json",
        "$TURBO_ROOT$/.agents/skills/orchestrate-phase-delivery/scripts/*.mjs"
      ]
    }
  }
}
