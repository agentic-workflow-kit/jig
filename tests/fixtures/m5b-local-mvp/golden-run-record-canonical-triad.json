{
  "run": {
    "id": "<RUN_ID>",
    "attempt": 1,
    "status": "failure",
    "planId": "canonical-triad",
    "mode": "local-dry-run",
    "binding": {
      "policyRef": "policy:assisted-v0",
      "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>",
      "workspace": {
        "kind": "git",
        "root": "<WORKSPACE>",
        "repoRoot": "<WORKSPACE>",
        "head": "<WORKSPACE_HEAD>",
        "changeSetHash": "<WORKSPACE_HASH>"
      }
    },
    "posture": {
      "record": "safe-for-owner-record",
      "export": "redacted"
    },
    "planSnapshot": {
      "ref": "<PLAN_SNAPSHOT_REF>",
      "path": "<PLAN_SNAPSHOT_PATH>"
    },
    "policySnapshot": {
      "ref": "<POLICY_SNAPSHOT_REF>",
      "path": "<POLICY_SNAPSHOT_PATH>"
    }
  },
  "events": [
    {
      "family": "run.started",
      "runId": "<RUN_ID>",
      "planId": "canonical-triad",
      "mode": "local-dry-run",
      "binding": {
        "policyRef": "policy:assisted-v0",
        "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>",
        "workspace": {
          "kind": "git",
          "root": "<WORKSPACE>",
          "repoRoot": "<WORKSPACE>",
          "head": "<WORKSPACE_HEAD>",
          "changeSetHash": "<WORKSPACE_HASH>"
        }
      },
      "posture": {
        "record": "safe-for-owner-record",
        "export": "redacted"
      },
      "planSnapshot": {
        "ref": "<PLAN_SNAPSHOT_REF>",
        "path": "<PLAN_SNAPSHOT_PATH>"
      },
      "policySnapshot": {
        "ref": "<POLICY_SNAPSHOT_REF>",
        "path": "<POLICY_SNAPSHOT_PATH>"
      },
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.started",
      "storyId": "STORY-A",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.requested",
      "storyId": "STORY-A",
      "requestId": "REQ-A-edit",
      "requestKind": "edit-files",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.granted",
      "storyId": "STORY-A",
      "requestId": "REQ-A-edit",
      "requestKind": "edit-files",
      "basis": ["declared-request", "in-scope", "CFG-10:reversible"],
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.requested",
      "storyId": "STORY-A",
      "requestId": "REQ-A-check",
      "requestKind": "run-checks",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.granted",
      "storyId": "STORY-A",
      "requestId": "REQ-A-check",
      "requestKind": "run-checks",
      "basis": ["declared-request", "CFG-10:reversible"],
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "evidence.modeled",
      "storyId": "STORY-A",
      "result": "passed",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.done",
      "storyId": "STORY-A",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "runner-action.skipped-on-dry-run",
      "storyId": "STORY-A",
      "action": "push|open-pr|merge",
      "reason": "dry-run",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.started",
      "storyId": "STORY-C",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.requested",
      "storyId": "STORY-C",
      "requestId": "REQ-C-rule",
      "requestKind": "edit-rule-governing-file",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.routed",
      "storyId": "STORY-C",
      "requestId": "REQ-C-rule",
      "requestKind": "edit-rule-governing-file",
      "basis": ["GUARD-2", "rule-governing-surface"],
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.parked",
      "storyId": "STORY-C",
      "requestId": "REQ-C-rule",
      "reason": "owner-decision-required",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.started",
      "storyId": "STORY-D",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.requested",
      "storyId": "STORY-D",
      "requestId": "REQ-D-outside",
      "requestKind": "edit-files",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "authorization.denied",
      "storyId": "STORY-D",
      "requestId": "REQ-D-outside",
      "requestKind": "edit-files",
      "basis": ["FENCE-1", "out-of-declared-scope"],
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.blocked",
      "storyId": "STORY-D",
      "reason": "authorization-denied",
      "diagnostics": {
        "error": "Authorization denied for request \"REQ-D-outside\""
      },
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "story.blocked",
      "storyId": "STORY-E",
      "blockedBy": "STORY-D",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    {
      "family": "run.stopped",
      "reason": "unattended-park",
      "checkpoint": "after:STORY-C.parked",
      "unstarted": [],
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    }
  ]
}
