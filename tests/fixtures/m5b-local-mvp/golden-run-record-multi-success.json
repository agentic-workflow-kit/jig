{
  "run": {
    "id": "<RUN_ID>",
    "attempt": 1,
    "status": "success",
    "planId": "multi-item-success",
    "mode": "local-dry-run",
    "binding": {
      "policyRef": "local-dry-run-policy",
      "configRef": "mode=local-dry-run;recordDir=<RECORD_DIR>"
    }
  },
  "events": [
    { "family": "run.started", "actor": "runner", "timestamp": "<TIMESTAMP>" },
    { "family": "story.started", "storyId": "STORY-1", "actor": "runner", "timestamp": "<TIMESTAMP>" },
    {
      "family": "evidence.modeled",
      "storyId": "STORY-1",
      "result": "passed",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    { "family": "story.done", "storyId": "STORY-1", "actor": "runner", "timestamp": "<TIMESTAMP>" },
    { "family": "story.started", "storyId": "STORY-2", "actor": "runner", "timestamp": "<TIMESTAMP>" },
    {
      "family": "evidence.modeled",
      "storyId": "STORY-2",
      "result": "passed",
      "actor": "runner",
      "timestamp": "<TIMESTAMP>"
    },
    { "family": "story.done", "storyId": "STORY-2", "actor": "runner", "timestamp": "<TIMESTAMP>" },
    { "family": "run.completed", "actor": "runner", "timestamp": "<TIMESTAMP>" }
  ]
}
