{
  "name": "@agentic-workflow-kit/jig-repo",
  "version": "0.0.0",
  "description": "Repository tooling for Jig, the agentic-workflow-kit delivery engine.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "warn"
    }
  },
  "bin": {
    "jig": "bin/jig.js"
  },
  "scripts": {
    "dev:setup": "bash scripts/dev-setup.sh",
    "worktree:new": "bash scripts/worktree-new.sh",
    "worktree:clean": "bash scripts/worktree-clean.sh",
    "format": "prettier --write \"**/*.{md,yml,yaml,json}\"",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,json}\"",
    "lint": "pnpm format:check",
    "delivery:check": "node scripts/check-delivery-foundation.mjs",
    "check": "pnpm lint && pnpm delivery:check && pnpm test",
    "test": "node --test test/*.test.js",
    "coverage": "c8 node --test test/*.test.js"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "glob": "^13.0.6",
    "prettier": "^3.6.2"
  }
}
